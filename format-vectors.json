      "id": "fx-frost-desaturate-negative",
      "accept": false,
      "why": "and desaturation cannot run backwards",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          {
            "kind": "frost",
            "desaturate": -0.1
          }
        ]
      }
    },
    {
      "id": "fx-fill-shading-above-one",
      "accept": false,
      "why": "keepShading is a fraction too",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          {
            "kind": "fill",
            "region": "lowerFace",
            "keepShading": 1.2
          }
        ]
      }
    },
    {
      "id": "fx-fill-feather-absurd",
      "accept": false,
      "why": "feather is in pupil-gaps, so three is a face and a half of blur",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          {
            "kind": "fill",
            "region": "lowerFace",
            "feather": 3
          }
        ]
      }
    },
    {
      "id": "fx-number-is-a-bool",
      "accept": false,
      "why": "true is not a number, whatever Python says about isinstance(True, int)",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          {
            "kind": "fill",
            "region": "lowerFace",
            "keepShading": true
          }
        ]
      }
    },
    {
      "id": "fx-number-is-a-string",
      "accept": false,
      "why": "nor is a number written as text",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          {
            "kind": "frost",
            "blur": "0.2"
          }
        ]
      }
    },
    {
      "id": "fx-effects-need-schema-3",
      "accept": false,
      "why": "a lens claiming schema 2 with effects is lying about what it needs to be drawn, and would come out as an ordinary photograph",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 2,
        "effects": [
          {
            "kind": "frost"
          }
        ]
      }
    },
    {
      "id": "fx-effects-without-a-schema",
      "accept": false,
      "why": "and one that says nothing at all defaults to schema 1",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "effects": [
          {
            "kind": "frost"
          }
        ]
      }
    },
    {
      "id": "fx-schema-past-the-newest",
      "accept": false,
      "why": "schema 4 does not exist yet, so a lens written for it cannot be drawn here -- refused rather than half-drawn",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 4,
        "effects": [
          {
            "kind": "frost"
          }
        ]
      }
    },
    {
      "id": "fx-effect-is-null",
      "accept": false,
      "why": "a null in the list is not an effect",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          null
        ]
      }
    },
    {
      "id": "fx-kind-not-a-string",
      "accept": false,
      "why": "nor is a kind written as a number",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          {
            "kind": 3
          }
        ]
      }
    },
    {
      "id": "fx-blur-at-the-limit",
      "accept": true,
      "why": "two pupil-gaps is the most, and the most is allowed",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          {
            "kind": "frost",
            "blur": 2,
            "feather": 2
          }
        ]
      }
    },
    {
      "id": "fx-shading-at-the-limits",
      "accept": true,
      "why": "so are both ends of a fraction",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          {
            "kind": "fill",
            "region": "lowerFace",
            "keepShading": 1
          },
          {
            "kind": "frost",
            "desaturate": 0,
            "lift": 1
          }
        ]
      }
    },
    {
      "id": "fx-unknown-keys-are-ignored",
      "accept": true,
      "why": "a key neither side knows is skipped rather than refused: that is what the schema number is for, and a field added later must not make an older app throw the whole lens away",
      "lens": {
        "id": "fx",
        "name": "Effect",
        "schema": 3,
        "effects": [
          {
            "kind": "frost",
            "sparkle": true,
            "tint": "#ff0000"
          }
        ]
      }
    }
  ]
